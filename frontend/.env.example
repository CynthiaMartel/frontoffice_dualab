# .env.example — Microretos Frontend (Vue 3)
VITE_API_URL=http://localhost:8000/api

# Escaparate público de microretos — backend del tool DuaLab (proyecto microretos),
# no el backend propio de este frontoffice. En local, la URL del `php artisan serve`
# del proyecto microretos.
VITE_MICRORETOS_API_URL=http://localhost:8000/api

# Frontend de la herramienta DuaLab (botón "Iniciar sesión") — en local es el
# puerto del `npm run dev` de frontend-microretos.
VITE_TOOL_URL=http://localhost:5173
